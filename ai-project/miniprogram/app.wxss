/**app.wxss 全局样式**/
page {
  background: #f5f6fa;
  font-size: 28rpx;
  color: #333;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC',
    'Microsoft YaHei', sans-serif;
}

.container {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(29, 58, 143, 0.05);
}

.btn-primary {
  background: #1d3a8f;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.btn-primary::after {
  border: none;
}

.empty {
  text-align: center;
  color: #a0a6b3;
  padding: 120rpx 0;
  font-size: 26rpx;
}

.tag {
  display: inline-block;
  font-size: 22rpx;
  color: #1d3a8f;
  background: rgba(29, 58, 143, 0.08);
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
  margin-right: 12rpx;
  margin-top: 8rpx;
}
