.stat-banner {
  background: linear-gradient(135deg, #1d3a8f 0%, #2f56c4 100%);
  padding: 40rpx 24rpx 36rpx;
  display: flex;
}
.stat-item {
  flex: 1;
  text-align: center;
  color: #fff;
}
.stat-num {
  font-size: 36rpx;
  font-weight: 700;
}
.stat-label {
  font-size: 22rpx;
  opacity: 0.8;
  margin-top: 6rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}
.empty.small {
  padding: 40rpx 0;
}

/* 订阅 */
.sub-input-row {
  display: flex;
  margin-bottom: 20rpx;
}
.sub-input {
  flex: 1;
  height: 72rpx;
  background: #f2f4f8;
  border-radius: 40rpx;
  padding: 0 30rpx;
  font-size: 26rpx;
}
.sub-add {
  margin-left: 20rpx;
  color: #fff;
  background: #1d3a8f;
  padding: 0 36rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  font-size: 26rpx;
}
.sub-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f4f5f8;
  font-size: 27rpx;
}
.sub-del {
  color: #e26d3a;
  font-size: 24rpx;
}

/* 收藏 */
.fav-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f4f5f8;
}
.fav-item:last-child {
  border-bottom: none;
}
.fav-main {
  flex: 1;
  margin-right: 20rpx;
}
.fav-title {
  font-size: 27rpx;
  font-weight: 500;
}
.fav-company {
  font-size: 24rpx;
  color: #8a8f99;
  margin-top: 8rpx;
}
.fav-del {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #1d3a8f;
}
