<view class="page">
  <!-- 顶部信息栏 -->
  <view class="banner">
    <view class="banner-title">国企好岗 · 每日更新</view>
    <view class="banner-sub" wx:if="{{lastSyncText}}">{{lastSyncText}}</view>
    <view class="banner-sub" wx:else>每晚 12:00 自动刷新收录</view>
  </view>

  <!-- 分类 Tab -->
  <scroll-view class="tabs" scroll-x enable-flex>
    <view
      wx:for="{{categories}}"
      wx:key="key"
      class="tab {{activeCategory === item.key ? 'tab-active' : ''}}"
      data-key="{{item.key}}"
      bindtap="switchCategory"
    >{{item.name}}</view>
  </scroll-view>

  <!-- 职位列表 -->
  <view class="container">
    <view class="card job-card" wx:for="{{jobs}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
      <view class="job-head">
        <view class="job-title">{{item.title}}</view>
        <view class="job-category">{{item.categoryName}}</view>
      </view>
      <view class="job-company">{{item.company}}</view>
      <view class="job-meta">
        <text wx:if="{{item.location}}">{{item.location}}</text>
        <text wx:if="{{item.salary}}">{{item.salary}}</text>
        <text wx:if="{{item.education}}">{{item.education}}</text>
      </view>
      <view class="job-foot">
        <text class="job-deadline" wx:if="{{item.deadlineText}}">截止 {{item.deadlineText}}</text>
        <text class="job-source">{{item.sourceName}}</text>
      </view>
    </view>

    <view class="empty" wx:if="{{!loading && jobs.length === 0}}">暂无职位，下拉刷新试试</view>
    <view class="empty" wx:if="{{loading}}">加载中...</view>
  </view>
</view>
